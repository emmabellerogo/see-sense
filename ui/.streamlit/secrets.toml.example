# For local dev: copy to ui/.streamlit/secrets.toml and start the UI from ui/
# (cd ui && streamlit run app.py). Starting from the repo root instead needs
# .streamlit/secrets.toml there (see the root example). On Streamlit Community
# Cloud, paste the same keys into the app's "Secrets" box.
# NEVER commit the real secrets.toml (it is in .gitignore).

API_URL = "https://your-service.onrender.com"
SUPABASE_URL = "https://your-project-ref.supabase.co"   # must end in .supabase.co
# The ANON key is public-safe: it can only SELECT from `runs` and from the
# `recent_classifications` view (migration 003). Do NOT put the service-role key here.
SUPABASE_ANON_KEY = "your-anon-key"
